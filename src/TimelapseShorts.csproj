<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Linux/macOS 上でもコンパイル確認できるようにする（実行はWindowsのみ） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!--
      アプリの名前は「KZHタイムラプス」（旧名: タイムラプス縦動画メーカー）。exe は英字の KZHTimelapse.exe（v0.7.3 から。前は
      TimelapseShorts.exe）。名前空間と、設定のフォルダ（%LOCALAPPDATA%\TimelapseShorts）は前のまま（今までの設定を引き継ぐ）
    -->
    <AssemblyName>KZHTimelapse</AssemblyName>
    <Product>KZHタイムラプス</Product>
    <AssemblyTitle>KZHタイムラプス</AssemblyTitle>
    <Version>1.0.0</Version>
    <!-- ダークモードに使う ThemeMode（Fluent テーマ）は .NET 10 では試験的な扱い。分かったうえで使う -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

</Project>
