<UserControl x:Class="TimelapseShorts.IntroPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:TimelapseShorts">
    <!-- ② 冒頭。左に元の動画、右に設定のカード、下に「全体」と「拡大」のバー。
         「長さ・投稿先」のカードと、下の「戻る／次へ」は MainWindow が LengthContent / FooterContent に入れる（MainWindow.xaml の IntroParts） -->
    <UserControl.Resources>
        <!-- MainWindow.xaml と同じく、Fluent の部品を少し詰める -->
        <sys:Double x:Key="TextControlThemeMinHeight">28</sys:Double>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,3,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,6,14,8"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>    <!-- 動画と設定 -->
            <RowDefinition Height="Auto"/> <!-- 下のバー -->
        </Grid.RowDefinitions>

        <Grid x:Name="TopArea">
            <Grid.ColumnDefinitions>
                <!-- 幅は、動画の枠が 9:16 になるよう IntroPanel.xaml.cs で決める -->
                <ColumnDefinition x:Name="VideoColumn" Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左: 元の動画（再生できれば再生、できなければバーの位置の画） -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 使える高さ（VideoHolder）に合わせて、VideoFrame を 9:16 の大きさにする -->
                <Border x:Name="VideoHolder" SizeChanged="VideoHolder_SizeChanged">
                    <Border x:Name="VideoFrame" Background="#1e1e1e" CornerRadius="4" VerticalAlignment="Top" HorizontalAlignment="Left"
                            MouseLeftButtonUp="VideoFrame_MouseLeftButtonUp">
                        <Grid>
                            <Image x:Name="FrameImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
                                          ScrubbingEnabled="True" Volume="0.5" Visibility="Collapsed"
                                          MediaOpened="Player_MediaOpened" MediaFailed="Player_MediaFailed"
                                          MediaEnded="Player_MediaEnded"/>
                            <TextBlock x:Name="VideoPlaceholder" Foreground="#bbb" TextWrapping="Wrap" TextAlignment="Center"
                                       VerticalAlignment="Center" Margin="20"/>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,3"
                                    CornerRadius="4" Background="#B0000000">
                                <TextBlock x:Name="BadgeText" Foreground="White" FontSize="12"/>
                            </Border>
                        </Grid>
                    </Border>
                </Border>
                <TextBlock Grid.Row="1" x:Name="VideoNote" Style="{StaticResource Note}" Margin="0,6,0,0"/>
            </Grid>

            <!-- 右: 設定のカード（窓が小さいときはスクロール）と、戻る／次へ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="冒頭の長さ" Style="{StaticResource CardTitle}"/>
                                <DockPanel>
                                    <Button x:Name="LastButton" DockPanel.Dock="Right" Content="最後に合わせる" Padding="12,4"
                                            VerticalAlignment="Center" Margin="12,0,0,0" Click="LastButton_Click"
                                            ToolTip="範囲を、元の動画の最後に合わせる（完成品は、たいてい最後に映っているため）"/>
                                    <WrapPanel VerticalAlignment="Center">
                                        <CheckBox x:Name="IntroCheck" Content="完成品などを冒頭に" IsChecked="True" Margin="0,0,16,0"
                                                  Checked="IntroCheck_Changed" Unchecked="IntroCheck_Changed"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                            <TextBlock Text="冒頭" VerticalAlignment="Center"/>
                                            <TextBox x:Name="SecondsBox" TextChanged="SecondsBox_TextChanged" LostFocus="SecondsBox_LostFocus"/>
                                            <TextBlock Text="秒" VerticalAlignment="Center"/>
                                            <TextBlock Text="⇄" Margin="10,0,0,0" FontWeight="Bold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="RangeText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </WrapPanel>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0"
                                           Text="バーで範囲を変えると秒数が、秒数を変えるとバーが変わります（冒頭は本編と同じ速さ）。秒数を変えたときは、範囲の終わりはそのままで、始まりが動きます。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <WrapPanel>
                                <StackPanel Margin="0,0,40,0">
                                    <TextBlock Text="冒頭への持っていきかた" Style="{StaticResource CardTitle}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="MoveRadio" GroupName="Carry" Content="移す（本編からはなくす）" IsChecked="True"
                                                     Margin="0,0,24,0" Checked="Carry_Checked"/>
                                        <RadioButton x:Name="CopyRadio" GroupName="Carry" Content="コピー（本編にも残す）"
                                                     Checked="Carry_Checked"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- 冒頭の部分だけのフェード（黒から出てきて、黒に消えてから本編につなぐ）。0 秒でなし -->
                                <StackPanel>
                                    <TextBlock Text="フェード" Style="{StaticResource CardTitle}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="イン" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FadeInBox" Text="0.3" TextChanged="Fade_TextChanged"/>
                                        <TextBlock Text="アウト" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FadeOutBox" Text="0.3" TextChanged="Fade_TextChanged"/>
                                        <TextBlock Text="秒" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </WrapPanel>
                        </Border>

                        <!-- 長さ・投稿先（MainWindow が入れる） -->
                        <ContentControl x:Name="LengthSlot" Focusable="False"/>

                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Name="OrderTitle" Text="出来上がりの並び" Style="{StaticResource CardTitle}"/>
                                <!-- 冒頭と本編の長さの割合で並べる（幅は IntroPanel.xaml.cs で決める） -->
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="OrderIntroColumn" Width="1*" MinWidth="76"/>
                                        <ColumnDefinition x:Name="OrderMainColumn" Width="10*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="OrderIntroBorder" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4,0,0,4">
                                        <TextBlock x:Name="OrderIntroText" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13"/>
                                    </Border>
                                    <Border Grid.Column="1" x:Name="OrderMainBorder" Background="#8a94a3" CornerRadius="0,4,4,0">
                                        <TextBlock x:Name="OrderMainText" Foreground="White" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="1" x:Name="ErrorText" Margin="2,6,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                <!-- 戻る／次へ（MainWindow が入れる） -->
                <ContentControl Grid.Row="2" x:Name="FooterSlot" Focusable="False" Margin="0,8,0,0"/>
            </Grid>
        </Grid>

        <!-- 下: 再生・時刻・「ここから」「ここまで」と、全体と拡大の 2 本のバー -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,8,14,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,6">
                    <Button x:Name="PlayButton" Content="▶" Width="40" Padding="0,4" Click="PlayButton_Click"
                            ToolTip="再生／一時停止（動画をクリックしても同じ）"/>
                    <TextBlock x:Name="TimeText" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button x:Name="FromButton" Content="ここから" Padding="14,4" Margin="16,0,0,0" Click="FromButton_Click"
                            ToolTip="今の位置を、範囲のはじめにする"/>
                    <Button x:Name="ToButton" Content="ここまで" Padding="14,4" Margin="8,0,0,0" Click="ToButton_Click"
                            ToolTip="今の位置を、範囲の終わりにする"/>
                    <TextBlock x:Name="HintText" Style="{StaticResource Note}" FontSize="13" Margin="16,0,0,0"
                               Text="ドラッグで範囲を選ぶ・範囲ごと横にずらす・両端をつまんで調整。クリックで、その位置を見る。ホイールで拡大・縮小"/>
                </DockPanel>
                <TextBlock Grid.Row="1" Text="全体" Margin="0,4,0,0" Style="{StaticResource Note}" VerticalAlignment="Top"/>
                <local:RangeBar Grid.Row="1" Grid.Column="1" x:Name="OverallBar" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="2" Text="拡大" Margin="0,4,0,0" Style="{StaticResource Note}" VerticalAlignment="Top"/>
                <local:RangeBar Grid.Row="2" Grid.Column="1" x:Name="ZoomBar"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
