<Window x:Class="TimelapseShorts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:local="clr-namespace:TimelapseShorts"
        Title="タイムラプス縦動画メーカー" Width="1480" Height="720" MinWidth="1240" MinHeight="650"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop" Loaded="Window_Loaded"
        FontFamily="Yu Gothic UI" FontSize="14"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- 色はテーマ（ライト／ダーク）の色を使う。テーマは SettingsWindow.ApplyTheme で切り替える -->
    <Window.Resources>
        <!-- Fluent テーマの部品は大きめなので、小さいノートPC（1280×720・150%）に収まるよう少し詰める -->
        <sys:Double x:Key="TextControlThemeMinHeight">28</sys:Double>
        <Thickness x:Key="ComboBoxPadding">10,3,0,4</Thickness>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,3,0,0"/>
        </Style>
        <!-- 投稿先・プレビューの「最初・真ん中・最後」のボタンは、マスいっぱいに広げる -->
        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <!-- 手順のボタン（① 動画 ▶ ② 冒頭 …）。押した状態が残り、1つだけ選べる -->
        <Style x:Key="Step" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="GroupName" Value="Step"/>
            <Setter Property="Padding" Value="22,6"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <!-- 済んだ手順の ✓。ボタンの右の余白に重ねる（ボタンの文字は変えないので、幅も変わらない） -->
        <Style x:Key="StepMark" TargetType="TextBlock">
            <Setter Property="Text" Value="✓"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Hidden"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
        </Style>
        <Style x:Key="StepArrow" TargetType="TextBlock">
            <Setter Property="Text" Value="▶"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Style>
        <!-- 設定のカード -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,6,14,8"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <!-- 補足（灰色の小さい字） -->
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- 下の「戻る／次へ」 -->
        <Style x:Key="Footer" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,10,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 手順のボタン -->
            <RowDefinition Height="*"/>    <!-- 手順の画面 -->
        </Grid.RowDefinitions>

        <!-- 手順のボタン（どの手順にも直接行ける）と、設定 -->
        <DockPanel Margin="0,0,0,12">
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="設定" Padding="14,5" VerticalAlignment="Center"
                    Click="SettingsButton_Click"
                    ToolTip="画面の色（ライト／ダーク）・できた動画の保存先・作成が終わったときの動き"/>
            <StackPanel x:Name="StepBar" Orientation="Horizontal">
                <Grid>
                    <RadioButton x:Name="StepVideo" Style="{StaticResource Step}" Tag="0" Content="① 動画" IsChecked="True" Checked="Step_Checked"/>
                    <TextBlock x:Name="StepVideoMark" Style="{StaticResource StepMark}"/>
                </Grid>
                <TextBlock Style="{StaticResource StepArrow}"/>
                <Grid>
                    <RadioButton x:Name="StepIntro" Style="{StaticResource Step}" Tag="1" Content="② 冒頭" Checked="Step_Checked"/>
                    <TextBlock x:Name="StepIntroMark" Style="{StaticResource StepMark}"/>
                </Grid>
                <TextBlock Style="{StaticResource StepArrow}"/>
                <Grid>
                    <RadioButton x:Name="StepBgm" Style="{StaticResource Step}" Tag="2" Content="③ BGM" Checked="Step_Checked"/>
                    <TextBlock x:Name="StepBgmMark" Style="{StaticResource StepMark}"/>
                </Grid>
                <TextBlock Style="{StaticResource StepArrow}"/>
                <Grid>
                    <RadioButton x:Name="StepText" Style="{StaticResource Step}" Tag="3" Content="④ テキスト" Checked="Step_Checked"/>
                    <TextBlock x:Name="StepTextMark" Style="{StaticResource StepMark}"/>
                </Grid>
                <TextBlock Style="{StaticResource StepArrow}"/>
                <Grid>
                    <RadioButton x:Name="StepMake" Style="{StaticResource Step}" Tag="4" Content="⑤ 作成" Checked="Step_Checked"/>
                    <TextBlock x:Name="StepMakeMark" Style="{StaticResource StepMark}"/>
                </Grid>
            </StackPanel>
        </DockPanel>

        <!-- 手順の画面。左に画（9:16）、右に設定のカード。② だけは左右いっぱいを IntroPanel が使う -->
        <Grid Grid.Row="1" x:Name="StepArea">
            <Grid.ColumnDefinitions>
                <!-- 幅は、左の画が使える高さいっぱいの 9:16 になるよう MainWindow.xaml.cs で決める -->
                <ColumnDefinition x:Name="PictureColumn" Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ① の左: 入れた動画の最初の画 -->
            <Grid x:Name="SourcePicture">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="SourceHolder" SizeChanged="PictureHolder_SizeChanged">
                    <Border x:Name="SourceFrame" Background="#1e1e1e" CornerRadius="4" Width="300" Height="533"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid>
                            <Image x:Name="SourceImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="SourcePlaceholder" Foreground="#bbb" TextWrapping="Wrap" TextAlignment="Center"
                                       VerticalAlignment="Center" Margin="20" Text="動画を入れると、ここに最初の画が出ます"/>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,3"
                                    CornerRadius="4" Background="#B0000000">
                                <TextBlock Text="元の動画（1本目の最初）" Foreground="White" FontSize="12"/>
                            </Border>
                        </Grid>
                    </Border>
                </Border>
                <TextBlock Grid.Row="1" Style="{StaticResource Note}" Margin="0,6,0,0" Text="入れた動画の最初の画です"/>
            </Grid>

            <!-- ③④⑤ の左: 出来上がりのプレビュー（最初・真ん中・最後の画か、最初の数秒の動画） -->
            <Grid x:Name="PreviewArea" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="PreviewHolder" SizeChanged="PictureHolder_SizeChanged">
                    <!-- 動画のプレビューを出しているときは、クリックで一時停止・続き・もう一度 -->
                    <Border x:Name="PreviewFrame" Background="#1e1e1e" Width="268" Height="476"
                            HorizontalAlignment="Left" VerticalAlignment="Top" MouseLeftButtonUp="PreviewFrame_MouseLeftButtonUp">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <!-- 動画のプレビュー（最初の数秒・BGM 入り）。音量は PC の音量のまま（BGM の大きさを確かめるため） -->
                            <MediaElement x:Name="PreviewVideo" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
                                          Volume="1" Visibility="Collapsed" ScrubbingEnabled="True"
                                          MediaEnded="PreviewVideo_MediaEnded" MediaFailed="PreviewVideo_MediaFailed"/>
                            <StackPanel VerticalAlignment="Center" Margin="20">
                                <TextBlock x:Name="PreviewPlaceholder" Foreground="#bbb" TextWrapping="Wrap" TextAlignment="Center"
                                           Text="動画を入れて、下の「プレビュー」を押すと、ここに出来上がりの画が出ます"/>
                                <!-- ここで再生できなかったときだけ出す（Windows の動画アプリなどで開く） -->
                                <Button x:Name="PreviewOpenButton" Content="ほかのアプリで開く" Padding="12,4" Margin="0,12,0,0"
                                        HorizontalAlignment="Center" Visibility="Collapsed" Click="PreviewOpenButton_Click"/>
                            </StackPanel>
                            <!-- 動画を止めたとき・最後まで見たとき -->
                            <Border x:Name="PreviewReplay" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,8"
                                    CornerRadius="20" Background="#B0000000" Visibility="Collapsed" IsHitTestVisible="False">
                                <TextBlock x:Name="PreviewReplayText" Foreground="White"/>
                            </Border>
                            <!-- 表示中の画・動画を作ったあとに設定が変わったら知らせる -->
                            <Border x:Name="PreviewStale" VerticalAlignment="Bottom" Background="#D0000000" Padding="10,8"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="PreviewStaleText" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>
                </Border>
                <StackPanel Grid.Row="1" x:Name="PreviewControls">
                    <UniformGrid Columns="4" Margin="-3,6,-3,0">
                        <RadioButton x:Name="PreviewFirstRadio" Content="最初" GroupName="PreviewFrame" IsChecked="True"
                                     Margin="3" Padding="4" Style="{DynamicResource {x:Type ToggleButton}}"
                                     Checked="PreviewFrame_Checked"/>
                        <RadioButton x:Name="PreviewMiddleRadio" Content="真ん中" GroupName="PreviewFrame"
                                     Margin="3" Padding="4" Style="{DynamicResource {x:Type ToggleButton}}"
                                     Checked="PreviewFrame_Checked"/>
                        <RadioButton x:Name="PreviewLastRadio" Content="最後" GroupName="PreviewFrame"
                                     Margin="3" Padding="4" Style="{DynamicResource {x:Type ToggleButton}}"
                                     Checked="PreviewFrame_Checked"/>
                        <RadioButton x:Name="PreviewVideoRadio" Content="動画" GroupName="PreviewFrame"
                                     Margin="3" Padding="4" Style="{DynamicResource {x:Type ToggleButton}}"
                                     Checked="PreviewFrame_Checked"/>
                    </UniformGrid>
                    <TextBlock x:Name="PreviewCaption" Style="{StaticResource Note}" Margin="0,2,0,0" TextAlignment="Center"/>
                    <!-- 動画のプレビューを作っている間の進み具合 -->
                    <ProgressBar x:Name="PreviewBar" Height="4" Maximum="1" Margin="0,4,0,0" Visibility="Collapsed"/>
                    <!-- 2つ横に並べる（縦に重ねるとプレビューの枠が小さくなるため） -->
                    <UniformGrid Columns="2" Margin="-4,6,-4,0">
                        <Button x:Name="PreviewButton" Content="プレビュー" Padding="8,6" Margin="4,0" HorizontalAlignment="Stretch"
                                IsEnabled="False" Click="PreviewButton_Click"
                                ToolTip="出来上がりの最初・真ん中・最後の画を、作成する前に確かめます（静止画。数秒でできます）"/>
                        <Button x:Name="PreviewVideoButton" Content="動画で見る" Padding="8,6" Margin="4,0" HorizontalAlignment="Stretch"
                                IsEnabled="False" Click="PreviewVideoButton_Click"
                                ToolTip="出来上がりの最初の数秒（冒頭と、本編のはじめ）を、BGM つきの動画で確かめます"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <!-- ① 動画 -->
            <Grid Grid.Column="2" x:Name="VideoStep">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="40"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="AddButton" Content="動画を追加…" Padding="12,4" Click="AddButton_Click"/>
                                <Button x:Name="ClearButton" Content="クリア" Padding="12,4" Margin="8,0,0,0" Click="ClearButton_Click"/>
                            </StackPanel>
                            <TextBlock Text="動画" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0"/>
                        </DockPanel>
                        <Border Grid.Row="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                            <ListBox x:Name="FilesList" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Length}" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <TextBlock Grid.Row="2" x:Name="FilesTotalText" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="3" x:Name="FilesStatusText" Style="{StaticResource Note}" Margin="0,2,0,0"/>
                        <Grid Grid.Row="4" Margin="0,8,0,0">
                            <Rectangle Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="2"
                                       StrokeDashArray="4 3" RadiusX="6" RadiusY="6"/>
                            <TextBlock Margin="12,12" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="動画をこの画面にドラッグ＆ドロップ（複数可。名前順につなげて1本にします）。音楽ファイルを入れると BGM（③）になります"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="横向きで撮った動画の場合" Style="{StaticResource CardTitle}"/>
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="CropRadio" IsChecked="True" Checked="Settings_Changed" VerticalContentAlignment="Center"
                                         Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 絵: 縦長の枠いっぱいに、横長の画の真ん中だけ -->
                                    <Grid Width="36" Height="58">
                                        <Rectangle RadiusX="3" RadiusY="3">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#b79c75" Offset="0"/>
                                                    <GradientStop Color="#d6c19d" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Rectangle Width="22" Height="26" Fill="#f5f2ea"/>
                                    </Grid>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="中央を切り抜く" FontWeight="SemiBold"/>
                                        <TextBlock Text="画面いっぱい。左右は切れます" Style="{StaticResource Note}"/>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="BlurRadio" Checked="Settings_Changed" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 絵: 横長の画を真ん中に置き、上下はぼかした背景 -->
                                    <Grid Width="36" Height="58">
                                        <Rectangle RadiusX="3" RadiusY="3" Fill="#a8987f"/>
                                        <Rectangle Height="20" Fill="#c9b48e"/>
                                        <Rectangle Width="9" Height="11" Fill="#f5f2ea"/>
                                    </Grid>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="全体を残す" FontWeight="SemiBold"/>
                                        <TextBlock Text="上下をぼかした背景で埋めます" Style="{StaticResource Note}"/>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0" Text="縦向きで撮った動画は、どちらでも同じです"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="2" Style="{StaticResource Footer}">
                    <Button Content="次へ（冒頭）→" Tag="1" Padding="24,6" Style="{DynamicResource AccentButtonStyle}" Click="GoStep_Click"/>
                </StackPanel>
            </Grid>

            <!-- ② 冒頭（左右いっぱい） -->
            <local:IntroPanel Grid.ColumnSpan="3" x:Name="Intro" Visibility="Collapsed"/>

            <!--
              ② の「長さ・投稿先」と「戻る／次へ」。IntroPanel の中に出すが、XAML で作った UserControl の中身には
              名前を付けた部品を書けない（WPF の制限）ので、ここに書いて、MainWindow のコンストラクターで IntroPanel へ移す
            -->
            <Grid x:Name="IntroParts" Visibility="Collapsed">
                <Border x:Name="LengthCard" Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="長さ・投稿先" Style="{StaticResource CardTitle}"/>
                        <!-- 投稿先ボタンは MainWindow.xaml.cs で作る（最大の長さも表示）。横に 4 つ並べる -->
                        <UniformGrid x:Name="PlatformPanel" Columns="4" Margin="-3,0"/>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="総尺" VerticalAlignment="Center"/>
                            <TextBox x:Name="LengthBox" Width="64" Margin="8,0,12,0" Padding="2"
                                     VerticalAlignment="Center" TextChanged="Settings_TextChanged"/>
                            <TextBlock x:Name="LengthHint" Style="{StaticResource Note}" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="IntroFooter" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="← 戻る（動画）" Tag="0" Padding="18,6" Click="GoStep_Click"/>
                    <Button Content="次へ（BGM）→" Tag="2" Padding="24,6" Margin="8,0,0,0"
                            Style="{DynamicResource AccentButtonStyle}" Click="GoStep_Click"/>
                </StackPanel>
            </Grid>

            <!-- ③ BGM -->
            <Grid Grid.Column="2" x:Name="BgmStep" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="曲" Style="{StaticResource CardTitle}"/>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BgmSelectButton" Content="曲を選ぶ…" Padding="12,4" Click="BgmSelectButton_Click"/>
                                        <Button x:Name="BgmClearButton" Content="外す" Padding="12,4" Margin="8,0,0,0"
                                                Click="BgmClearButton_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="BgmText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                </DockPanel>
                                <TextBlock x:Name="BgmStatusText" Style="{StaticResource Note}" Margin="0,2,0,0"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0"
                                           Text="音楽ファイルを、この画面にドラッグ＆ドロップしても入れられます。曲が短いときは繰り返し、長いときは動画の長さで切ります。元の動画の音は入りません。"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="音量" Style="{StaticResource CardTitle}"/>
                                <!-- 音量（dB）と、調整後の平均・最大音量のバー（-60〜0 dB。0 dB を超えると音割れ） -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="音量" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="VolumeSlider" Minimum="-20" Maximum="10" Value="0"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0" VerticalAlignment="Center"
                                            ValueChanged="VolumeSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="VolumeText" Text="±0 dB" TextAlignment="Right"
                                               VerticalAlignment="Center" FontWeight="SemiBold"/>

                                    <TextBlock Grid.Row="1" Text="平均" FontSize="12" Margin="0,8,0,0" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Row="1" Grid.Column="1" x:Name="MeanBar" Minimum="-60" Maximum="0" Value="-60"
                                                 Height="12" Margin="8,8,8,0" Foreground="#3a9d5d"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="MeanText" FontSize="12" Margin="0,8,0,0"
                                               TextAlignment="Right" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Text="最大" FontSize="12" Margin="0,4,0,0" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Row="2" Grid.Column="1" x:Name="PeakBar" Minimum="-60" Maximum="0" Value="-60"
                                                 Height="12" Margin="8,4,8,0" Foreground="#3a9d5d"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="PeakText" FontSize="12" Margin="0,4,0,0"
                                               TextAlignment="Right" VerticalAlignment="Center"/>

                                    <!-- 目盛り（-60, -40, -20, 0 dB の位置に合わせて3等分） -->
                                    <UniformGrid Grid.Row="3" Grid.Column="1" Columns="3" Margin="8,1,8,0">
                                        <TextBlock Text="-60" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="-40" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <Grid>
                                            <TextBlock Text="-20" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="0 dB" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </UniformGrid>
                                </Grid>
                                <TextBlock x:Name="LevelNote" Margin="0,4,0,0" Style="{StaticResource Note}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="フェード" Style="{StaticResource CardTitle}"/>
                                <!-- 狭いときは2行に折り返す -->
                                <WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                                        <TextBlock Text="フェードイン" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FadeInBox" Text="0.5" Width="52" Margin="6,0" Padding="2"
                                                 VerticalAlignment="Center" TextChanged="Settings_TextChanged"/>
                                        <TextBlock Text="秒" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="フェードアウト" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FadeOutBox" Text="0.5" Width="52" Margin="6,0" Padding="2"
                                                 VerticalAlignment="Center" TextChanged="Settings_TextChanged"/>
                                        <TextBlock Text="秒" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Note}"
                                           Text="曲のはじめと終わりを、だんだん大きく・小さくします（0 秒でなし）。左の「動画で見る」で、出来上がりの最初の数秒を BGM つきで確かめられます。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Style="{StaticResource Footer}">
                    <Button Content="← 戻る（冒頭）" Tag="1" Padding="18,6" Click="GoStep_Click"/>
                    <Button Content="次へ（テキスト）→" Tag="3" Padding="24,6" Margin="8,0,0,0"
                            Style="{DynamicResource AccentButtonStyle}" Click="GoStep_Click"/>
                </StackPanel>
            </Grid>

            <!-- ④ テキスト -->
            <Grid Grid.Column="2" x:Name="TextStep" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="TextCheck" Content="テキストを入れる" FontWeight="Bold" FontSize="15"
                                          Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                                <TextBox x:Name="CaptionBox" Margin="0,4,0,0" Height="56" Padding="2" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Settings_TextChanged"/>
                                <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0" Text="文字は、動画の最初から最後まで出ます。改行もできます。"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="フォント" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="FontBox" Margin="12,0,0,0" SelectionChanged="Settings_SelectionChanged"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Note}" Margin="12,2,0,0"
                                           Text="★は同梱の Google Fonts、ほかはこの PC のフォント"/>
                                <TextBlock Grid.Row="2" Text="色" Margin="0,8,0,0" VerticalAlignment="Center"/>
                                <WrapPanel Grid.Row="2" Grid.Column="1" Margin="12,8,0,0">
                                    <ComboBox x:Name="ColorBox" Width="170" Margin="0,0,24,0" VerticalAlignment="Center"
                                              SelectionChanged="Settings_SelectionChanged"/>
                                    <!-- 背景なし: フチ取りの文字だけ / 背景あり: フチの色の帯の上に文字 -->
                                    <TextBlock Text="背景" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <RadioButton x:Name="BackNoneRadio" Content="なし" IsChecked="True" VerticalAlignment="Center"
                                                 Checked="Settings_Changed"/>
                                    <RadioButton x:Name="BackBoxRadio" Content="あり（帯）" Margin="16,0,0,0" VerticalAlignment="Center"
                                                 Checked="Settings_Changed"/>
                                </WrapPanel>
                                <TextBlock Grid.Row="3" Text="大きさ" Margin="0,8,0,0" VerticalAlignment="Center"/>
                                <WrapPanel Grid.Row="3" Grid.Column="1" Margin="12,8,0,0">
                                    <TextBox x:Name="SizeBox" Text="80" Width="56" Padding="2"
                                             VerticalAlignment="Center" TextChanged="Settings_TextChanged"/>
                                    <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center" Margin="8,0,24,0"
                                               Text="文字の高さ（横幅 1080 に対して。目安 60〜120）"/>
                                    <TextBlock Text="位置" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="PositionBox" Width="90" VerticalAlignment="Center" SelectionChanged="Settings_SelectionChanged"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="見本" Style="{StaticResource CardTitle}"/>
                                <!-- 背景なしのときは、灰色を動画に見立ててフチ取りの文字を乗せる -->
                                <Border x:Name="SampleBorder" Padding="10,6" CornerRadius="4">
                                    <TextBlock x:Name="SampleText" FontSize="22" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                                <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0"
                                           Text="見本はおおよその見た目です。出来上がりと同じ見た目は、左の「プレビュー」で確かめられます。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Style="{StaticResource Footer}">
                    <Button Content="← 戻る（BGM）" Tag="2" Padding="18,6" Click="GoStep_Click"/>
                    <Button Content="次へ（作成）→" Tag="4" Padding="24,6" Margin="8,0,0,0"
                            Style="{DynamicResource AccentButtonStyle}" Click="GoStep_Click"/>
                </StackPanel>
            </Grid>

            <!-- ⑤ 作成 -->
            <Grid Grid.Column="2" x:Name="MakeStep" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="設定のまとめ" Style="{StaticResource CardTitle}"/>
                                <!-- 「変える」で、その手順の画面に戻る -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="① 動画" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="SumVideoText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Column="2" Content="変える" Tag="0" Padding="12,3" Margin="0,3" Click="GoStep_Click"/>
                                    <TextBlock Grid.Row="1" Text="② 冒頭" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SumIntroText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="変える" Tag="1" Padding="12,3" Margin="0,3" Click="GoStep_Click"/>
                                    <TextBlock Grid.Row="2" Text="③ BGM" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SumBgmText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Row="2" Grid.Column="2" Content="変える" Tag="2" Padding="12,3" Margin="0,3" Click="GoStep_Click"/>
                                    <TextBlock Grid.Row="3" Text="④ テキスト" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SumTextText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Row="3" Grid.Column="2" Content="変える" Tag="3" Padding="12,3" Margin="0,3" Click="GoStep_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="保存先" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="SaveText" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="作成" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="InfoText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <!-- 進み具合（左）と、ボタン（右） -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="Bar" Height="8" Maximum="1" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                                        <Button x:Name="CancelButton" Content="中止" Padding="16,6" IsEnabled="False" Click="CancelButton_Click"/>
                                        <Button x:Name="StartButton" Content="作成する" Padding="24,6" Margin="8,0,0,0" FontWeight="Bold"
                                                IsEnabled="False" Style="{DynamicResource AccentButtonStyle}" Click="StartButton_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Button x:Name="OpenFolderButton" Content="保存先のフォルダを開く" Padding="12,4" Margin="0,6,0,0"
                                        HorizontalAlignment="Left" Visibility="Collapsed" Click="OpenFolderButton_Click"/>
                                <TextBlock x:Name="EncoderText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Style="{StaticResource Footer}">
                    <Button Content="← 戻る（テキスト）" Tag="3" Padding="18,6" Click="GoStep_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
