<Window x:Class="TimelapseShorts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="タイムラプス縦動画メーカー" Width="1480" Height="720" MinWidth="1240" MinHeight="650"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop" Loaded="Window_Loaded"
        FontFamily="Yu Gothic UI" FontSize="14"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- 色はテーマ（ライト／ダーク）の色を使う。テーマは SettingsWindow.ApplyTheme で切り替える -->
    <Window.Resources>
        <!-- Fluent テーマの部品は大きめなので、小さいノートPC（1280×720・150%）に収まるよう少し詰める -->
        <sys:Double x:Key="TextControlThemeMinHeight">28</sys:Double>
        <Thickness x:Key="ComboBoxPadding">10,3,0,4</Thickness>
        <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,6</Thickness>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,3,0,0"/>
        </Style>
        <!-- 投稿先・プレビューの「最初・真ん中・最後」のボタンは、マスいっぱいに広げる -->
        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <!-- 設定とプレビューの枠 -->
        <Style x:Key="Section" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Padding" Value="10,4,10,4"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="15"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 枠の中の補足（灰色の小さい字） -->
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <!-- 左: 動画・設定・作成ボタン / 右: プレビュー -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <!-- 幅は、プレビューが欄の高さいっぱいの 9:16 になるよう MainWindow.xaml.cs で決める -->
            <ColumnDefinition x:Name="PreviewColumn" Width="290"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>             <!-- 説明と、動画の追加・クリア -->
            <RowDefinition Height="*" MinHeight="60"/> <!-- 動画の一覧 -->
            <RowDefinition Height="Auto"/>             <!-- 設定（3列） -->
            <RowDefinition Height="Auto"/>             <!-- まとめ -->
            <RowDefinition Height="Auto"/>             <!-- 進み具合とボタン -->
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="動画をこの画面にドラッグ＆ドロップ（複数可。名前順につなげて1本にします）。音楽ファイルを入れると BGM になります。"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Button x:Name="AddButton" Content="動画を追加…" Padding="12,4" Click="AddButton_Click"/>
                <Button x:Name="ClearButton" Content="クリア" Padding="12,4" Margin="8,0,0,0" Click="ClearButton_Click"/>
                <Button x:Name="SettingsButton" Content="設定" Padding="12,4" Margin="16,0,0,0" Click="SettingsButton_Click"
                        ToolTip="画面の色（ライト／ダーク）・できた動画の保存先・作成が終わったときの動き"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="FilesList" BorderThickness="0"/>
        </Border>

        <!-- 設定は 3つの枠を横に並べて、全部いっぺんに見えるようにする。変換中はまとめて触れなくする -->
        <Grid Grid.Row="2" x:Name="SettingsPanel" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="LengthSection" Header="長さ・構成" Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="投稿先" FontWeight="SemiBold"/>
                    <!-- 投稿先ボタンは MainWindow.xaml.cs で作る（最大の長さも表示） -->
                    <UniformGrid x:Name="PlatformPanel" Columns="2" Margin="-3,2,-3,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="総尺" VerticalAlignment="Center"/>
                        <TextBox x:Name="LengthBox" Width="64" Margin="8,0,0,0" Padding="2"
                                 VerticalAlignment="Center" TextChanged="Settings_TextChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="LengthHint" Style="{StaticResource Note}" Margin="0,2,0,0"/>
                    <!-- 冒頭に持ってくる部分（完成品など）。くわしくは「冒頭を選ぶ…」の画面で選ぶ。
                         まとめの左は、チェックボックスの文字の位置にそろえる -->
                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="IntroButton" DockPanel.Dock="Right" Content="冒頭を選ぶ…" Padding="10,3"
                                VerticalAlignment="Center" Click="IntroButton_Click"
                                ToolTip="動画を見ながら、冒頭に持ってくる部分・長さ・フェードを選ぶ"/>
                        <CheckBox x:Name="IntroCheck" Content="完成品などを冒頭に" IsChecked="True" VerticalAlignment="Center"
                                  Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                    </DockPanel>
                    <TextBlock x:Name="IntroSummary" Margin="28,2,0,0" Style="{StaticResource Note}" FontSize="13"/>
                    <TextBlock Text="横向きで撮った動画の場合" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <RadioButton x:Name="CropRadio" IsChecked="True" Checked="Settings_Changed">
                        <TextBlock Text="中央を切り抜く（左右が切れる）" TextWrapping="Wrap"/>
                    </RadioButton>
                    <RadioButton x:Name="BlurRadio" Checked="Settings_Changed">
                        <TextBlock Text="全体を残す（上下はぼかした背景）" TextWrapping="Wrap"/>
                    </RadioButton>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" x:Name="BgmSection" Header="BGM" Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock x:Name="BgmText" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="BgmSelectButton" Content="曲を選ぶ…" Padding="12,3" Click="BgmSelectButton_Click"/>
                        <Button x:Name="BgmClearButton" Content="外す" Padding="12,3" Margin="8,0,0,0"
                                Click="BgmClearButton_Click"/>
                    </StackPanel>
                    <!-- 狭いときは2行に折り返す -->
                    <WrapPanel Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <TextBlock Text="フェードイン" VerticalAlignment="Center"/>
                            <TextBox x:Name="FadeInBox" Text="0.5" Width="40" Margin="6,0" Padding="2"
                                     VerticalAlignment="Center" TextChanged="Settings_TextChanged"/>
                            <TextBlock Text="秒" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="フェードアウト" VerticalAlignment="Center"/>
                            <TextBox x:Name="FadeOutBox" Text="0.5" Width="40" Margin="6,0" Padding="2"
                                     VerticalAlignment="Center" TextChanged="Settings_TextChanged"/>
                            <TextBlock Text="秒" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- 音量（dB）と、調整後の平均・最大音量のバー（-60〜0 dB。0 dB を超えると音割れ） -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="音量" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="VolumeSlider" Minimum="-20" Maximum="10" Value="0"
                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0" VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="VolumeText" Text="±0 dB" TextAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1" Text="平均" FontSize="12" Margin="0,8,0,0" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="1" Grid.Column="1" x:Name="MeanBar" Minimum="-60" Maximum="0" Value="-60"
                                     Height="12" Margin="8,8,8,0" Foreground="#3a9d5d"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="MeanText" FontSize="12" Margin="0,8,0,0"
                                   TextAlignment="Right" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Text="最大" FontSize="12" Margin="0,4,0,0" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="2" Grid.Column="1" x:Name="PeakBar" Minimum="-60" Maximum="0" Value="-60"
                                     Height="12" Margin="8,4,8,0" Foreground="#3a9d5d"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="PeakText" FontSize="12" Margin="0,4,0,0"
                                   TextAlignment="Right" VerticalAlignment="Center"/>

                        <!-- 目盛り（-60, -40, -20, 0 dB の位置に合わせて3等分） -->
                        <UniformGrid Grid.Row="3" Grid.Column="1" Columns="3" Margin="8,1,8,0">
                            <TextBlock Text="-60" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="-40" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <Grid>
                                <TextBlock Text="-20" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Text="0 dB" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </UniformGrid>
                    </Grid>
                    <TextBlock x:Name="LevelNote" Margin="0,4,0,0" Style="{StaticResource Note}"/>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Note}"
                               Text="曲が短いときは繰り返し、長いときは動画の長さで切ります。元の動画の音は入りません。フェードは 0 秒でなしになります。"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="4" x:Name="TextSection" Header="テキスト" Style="{StaticResource Section}">
                <StackPanel>
                    <CheckBox x:Name="TextCheck" Content="テキストを入れる" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                    <TextBox x:Name="CaptionBox" Margin="0,6,0,0" Height="48" Padding="2" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Settings_TextChanged"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="フォント" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="FontBox" Margin="8,0,0,0" SelectionChanged="Settings_SelectionChanged"/>
                        <TextBlock Grid.Row="1" Text="色" Margin="0,6,0,0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ColorBox" Width="160" Margin="8,6,0,0"
                                  HorizontalAlignment="Left" SelectionChanged="Settings_SelectionChanged"/>
                        <!-- 背景なし: フチ取りの文字だけ / 背景あり: フチの色の帯の上に文字 -->
                        <TextBlock Grid.Row="2" Text="背景" Margin="0,6,0,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="8,6,0,0">
                            <RadioButton x:Name="BackNoneRadio" Content="なし" IsChecked="True" VerticalAlignment="Center"
                                         Checked="Settings_Changed"/>
                            <RadioButton x:Name="BackBoxRadio" Content="あり（帯）" Margin="16,0,0,0" VerticalAlignment="Center"
                                         Checked="Settings_Changed"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="大きさ" Margin="0,6,0,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="8,6,0,0">
                            <TextBox x:Name="SizeBox" Text="80" Width="52" Padding="2"
                                     VerticalAlignment="Center" TextChanged="Settings_TextChanged"/>
                            <TextBlock Text="位置" Margin="16,0,8,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PositionBox" Width="76" SelectionChanged="Settings_SelectionChanged"/>
                        </StackPanel>
                    </Grid>
                    <!-- 見本。背景なしのときは、灰色を動画に見立ててフチ取りの文字を乗せる -->
                    <Border x:Name="SampleBorder" Margin="0,8,0,0" Padding="10,4" CornerRadius="4">
                        <TextBlock x:Name="SampleText" FontSize="20" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Note}"
                               Text="★は同梱の Google Fonts、ほかはこの PC のフォント。大きさは文字の高さ（横幅 1080 に対して。目安 60〜120）。文字は最初から最後まで表示します。"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="InfoText" Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <!-- 進み具合（左）と、ボタン（右） -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ProgressBar x:Name="Bar" Height="8" Maximum="1" Margin="0,6,0,0"/>
                <TextBlock x:Name="StatusText" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="EncoderText" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Top">
                <Button x:Name="OpenFolderButton" Content="出力フォルダを開く" Padding="12,6" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="OpenFolderButton_Click"/>
                <Button x:Name="CancelButton" Content="中止" Padding="16,6" Margin="0,0,8,0"
                        IsEnabled="False" Click="CancelButton_Click"/>
                <Button x:Name="StartButton" Content="作成する" Padding="20,6" FontWeight="Bold"
                        IsEnabled="False" Click="StartButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- プレビュー（出来上がりの最初・真ん中・最後のうち1枚を大きく表示） -->
        <GroupBox Grid.Column="2" Grid.RowSpan="5" x:Name="PreviewSection" Header="プレビュー" Style="{StaticResource Section}">
            <Grid x:Name="PreviewArea" SizeChanged="PreviewArea_SizeChanged">
                <StackPanel VerticalAlignment="Top">
                    <!-- 出来上がりと同じ 9:16 の枠。大きさは MainWindow.xaml.cs で決める -->
                    <!-- 動画のプレビューを出しているときは、クリックで一時停止・続き・もう一度 -->
                    <Border x:Name="PreviewFrame" Background="#1e1e1e" HorizontalAlignment="Center" Width="268" Height="476"
                            MouseLeftButtonUp="PreviewFrame_MouseLeftButtonUp">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <!-- 動画のプレビュー（最初の数秒・BGM 入り）。音量は PC の音量のまま（BGM の大きさを確かめるため） -->
                            <MediaElement x:Name="PreviewVideo" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
                                          Volume="1" Visibility="Collapsed" ScrubbingEnabled="True"
                                          MediaEnded="PreviewVideo_MediaEnded" MediaFailed="PreviewVideo_MediaFailed"/>
                            <StackPanel VerticalAlignment="Center" Margin="20">
                                <TextBlock x:Name="PreviewPlaceholder" Foreground="#bbb" TextWrapping="Wrap" TextAlignment="Center"
                                           Text="動画を入れて、下の「プレビュー」を押すと、ここに出来上がりの画が出ます"/>
                                <!-- ここで再生できなかったときだけ出す（Windows の動画アプリなどで開く） -->
                                <Button x:Name="PreviewOpenButton" Content="ほかのアプリで開く" Padding="12,4" Margin="0,12,0,0"
                                        HorizontalAlignment="Center" Visibility="Collapsed" Click="PreviewOpenButton_Click"/>
                            </StackPanel>
                            <!-- 動画を止めたとき・最後まで見たとき -->
                            <Border x:Name="PreviewReplay" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,8"
                                    CornerRadius="20" Background="#B0000000" Visibility="Collapsed" IsHitTestVisible="False">
                                <TextBlock x:Name="PreviewReplayText" Foreground="White"/>
                            </Border>
                            <!-- 表示中の画・動画を作ったあとに設定が変わったら知らせる -->
                            <Border x:Name="PreviewStale" VerticalAlignment="Bottom" Background="#D0000000" Padding="10,8"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="PreviewStaleText" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="PreviewControls">
                        <UniformGrid Columns="4" Margin="-3,6,-3,0">
                            <RadioButton x:Name="PreviewFirstRadio" Content="最初" GroupName="PreviewFrame" IsChecked="True"
                                         Margin="3" Padding="4" Style="{DynamicResource {x:Type ToggleButton}}"
                                         Checked="PreviewFrame_Checked"/>
                            <RadioButton x:Name="PreviewMiddleRadio" Content="真ん中" GroupName="PreviewFrame"
                                         Margin="3" Padding="4" Style="{DynamicResource {x:Type ToggleButton}}"
                                         Checked="PreviewFrame_Checked"/>
                            <RadioButton x:Name="PreviewLastRadio" Content="最後" GroupName="PreviewFrame"
                                         Margin="3" Padding="4" Style="{DynamicResource {x:Type ToggleButton}}"
                                         Checked="PreviewFrame_Checked"/>
                            <RadioButton x:Name="PreviewVideoRadio" Content="動画" GroupName="PreviewFrame"
                                         Margin="3" Padding="4" Style="{DynamicResource {x:Type ToggleButton}}"
                                         Checked="PreviewFrame_Checked"/>
                        </UniformGrid>
                        <TextBlock x:Name="PreviewCaption" Style="{StaticResource Note}" Margin="0,2,0,0"
                                   TextAlignment="Center"/>
                        <!-- 2つ横に並べる（縦に重ねるとプレビューの枠が小さくなるため） -->
                        <UniformGrid Columns="2" Margin="-4,8,-4,0">
                            <Button x:Name="PreviewButton" Content="プレビュー" Padding="8,6" Margin="4,0" HorizontalAlignment="Stretch"
                                    IsEnabled="False" Click="PreviewButton_Click"
                                    ToolTip="出来上がりの最初・真ん中・最後の画を、作成する前に確かめます（静止画。数秒でできます）"/>
                            <Button x:Name="PreviewVideoButton" Content="動画で見る" Padding="8,6" Margin="4,0" HorizontalAlignment="Stretch"
                                    IsEnabled="False" Click="PreviewVideoButton_Click"
                                    ToolTip="出来上がりの最初の数秒（完成品と、本編のはじめ）を、BGM つきの動画で確かめます"/>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
