<Window x:Class="TimelapseShorts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="タイムラプス縦動画メーカー" Width="620" Height="760" MinWidth="540" MinHeight="680"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop" Loaded="Window_Loaded"
        FontFamily="Yu Gothic UI" FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="動画をこの画面にドラッグ＆ドロップ（複数可。名前順につなげて1本にします）。音楽ファイルを入れると BGM になります。"/>

        <Border Grid.Row="1" BorderBrush="#999" BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="FilesList" BorderThickness="0"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="AddButton" Content="動画を追加…" Padding="12,4" Click="AddButton_Click"/>
            <Button x:Name="ClearButton" Content="クリア" Padding="12,4" Margin="8,0,0,0" Click="ClearButton_Click"/>
        </StackPanel>

        <TabControl Grid.Row="3" x:Name="SettingsTabs" Margin="0,12,0,0">
            <TabItem Header="長さ・構成">
                <StackPanel Margin="10">
                    <TextBlock Text="投稿先" FontWeight="SemiBold"/>
                    <!-- 投稿先ボタンは MainWindow.xaml.cs で作る（最大の長さも表示） -->
                    <UniformGrid x:Name="PlatformPanel" Columns="4" Margin="0,4,0,0"/>
                    <Grid Margin="3,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="総尺" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="LengthBox" Width="64" Margin="8,0" Padding="2"
                                 VerticalAlignment="Center" TextChanged="Settings_TextChanged"/>
                        <TextBlock Grid.Column="2" x:Name="LengthHint" VerticalAlignment="Center"
                                   Foreground="#666" TextWrapping="Wrap"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <CheckBox x:Name="IntroCheck" Content="完成品を冒頭に：最後の" IsChecked="True" VerticalAlignment="Center"
                                  Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                        <TextBox x:Name="IntroBox" Text="5" Width="40" Margin="6,0" Padding="2"
                                 VerticalAlignment="Center" TextChanged="Settings_TextChanged"/>
                        <TextBlock Text="秒を冒頭に移動する" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="横向きで撮った動画の場合" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    <RadioButton x:Name="CropRadio" IsChecked="True" Margin="0,4,0,2"
                                 Content="中央を切り抜く（画面いっぱい。左右は切れる）"/>
                    <RadioButton x:Name="BlurRadio" Margin="0,2"
                                 Content="全体を残す（上下をぼかした背景で埋める）"/>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="BgmTab" Header="BGM">
                <StackPanel Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="BgmText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" x:Name="BgmSelectButton" Content="曲を選ぶ…" Padding="12,4" Margin="8,0,0,0"
                                Click="BgmSelectButton_Click"/>
                        <Button Grid.Column="2" x:Name="BgmClearButton" Content="外す" Padding="12,4" Margin="8,0,0,0"
                                Click="BgmClearButton_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="フェードイン" VerticalAlignment="Center"/>
                        <TextBox x:Name="FadeInBox" Text="1" Width="48" Margin="6,0" Padding="2"
                                 VerticalAlignment="Center" TextChanged="Settings_TextChanged"/>
                        <TextBlock Text="秒" VerticalAlignment="Center"/>
                        <TextBlock Text="フェードアウト" Margin="24,0,0,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="FadeOutBox" Text="3" Width="48" Margin="6,0" Padding="2"
                                 VerticalAlignment="Center" TextChanged="Settings_TextChanged"/>
                        <TextBlock Text="秒" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Margin="0,14,0,0" Foreground="#666" TextWrapping="Wrap"
                               Text="曲が動画より短いときは繰り返し、長いときは動画の長さで切ります。元の動画の音は入りません。0秒にするとフェードなしです。"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="テキスト">
                <StackPanel Margin="10">
                    <CheckBox x:Name="TextCheck" Content="テキストを入れる（動画の最初から最後まで表示）"
                              Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                    <TextBox x:Name="CaptionBox" Margin="0,8,0,0" Height="52" Padding="2" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Settings_TextChanged"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="フォント" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="FontBox" Margin="8,0,0,0" SelectionChanged="Settings_SelectionChanged"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="大きさ" VerticalAlignment="Center"/>
                        <TextBox x:Name="SizeBox" Text="80" Width="48" Margin="8,0,0,0" Padding="2"
                                 VerticalAlignment="Center" TextChanged="Settings_TextChanged"/>
                        <TextBlock Text="色" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ColorBox" Width="150" Margin="8,0,0,0" SelectionChanged="Settings_SelectionChanged"/>
                        <TextBlock Text="位置" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="PositionBox" Width="72" Margin="8,0,0,0" SelectionChanged="Settings_SelectionChanged"/>
                    </StackPanel>
                    <Border x:Name="PreviewBorder" Margin="0,10,0,0" Padding="10,6" CornerRadius="4">
                        <TextBlock x:Name="PreviewText" FontSize="22" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                    <TextBlock Margin="0,6,0,0" Foreground="#666" FontSize="12" TextWrapping="Wrap"
                               Text="★は同梱の Google Fonts、それ以外はこの PC のフォントです。大きさは文字の高さ（画面の横幅 1080 に対して。目安 60〜120）。"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="4" x:Name="InfoText" Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="5" Margin="0,8,0,0">
            <ProgressBar x:Name="Bar" Height="18" Maximum="1"/>
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#555"/>
            <TextBlock x:Name="EncoderText" Margin="0,2,0,0" Foreground="#888" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OpenFolderButton" Content="出力フォルダを開く" Padding="12,6" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="OpenFolderButton_Click"/>
            <Button x:Name="CancelButton" Content="中止" Padding="16,6" Margin="0,0,8,0"
                    IsEnabled="False" Click="CancelButton_Click"/>
            <Button x:Name="StartButton" Content="作成する" Padding="20,6" FontWeight="Bold"
                    IsEnabled="False" Click="StartButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
