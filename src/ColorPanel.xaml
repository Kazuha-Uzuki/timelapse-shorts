<UserControl x:Class="TimelapseShorts.ColorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      ④ テキストの「自由に選ぶ（RGB）」。文字の色と、フチ・帯の色を、円形のカラーパレット（色の輪と明るさのバー）・
      R/G/B の数値・#RRGGBB・よく使う色で選ぶ。上の「文字の色」「フチ・帯の色」で、どちらを変えるかを切り替える。
    -->
    <UserControl.Resources>
        <!--
          明るさのバーは、スライダーの線を消して、後ろに黒から今の色までの変わり方を描く。
          Fluent のスライダーは「0 から今の値まで」を青く塗るので、それも出さない（IsSelectionRangeEnabled にすると、
          塗るのは SelectionStart〜SelectionEnd になり、どちらも 0 なので何も塗られない）
        -->
        <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent"/>
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent"/>
        <!-- よく使う色のボタン（色の四角。マウスを乗せると枠が太くなる） -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 選んでいる 2 色の小さな見本 -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="8,0,6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- どちらの色を変えるか -->
        <WrapPanel>
            <RadioButton x:Name="TextTarget" GroupName="ColorTarget" IsChecked="True" Margin="0,0,24,4" Checked="Target_Checked"
                         VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="文字の色" VerticalAlignment="Center"/>
                    <Border x:Name="TextChip" Style="{StaticResource Chip}"/>
                    <TextBlock x:Name="TextHex" VerticalAlignment="Center" FontFamily="Consolas"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="OutlineTarget" GroupName="ColorTarget" Margin="0,0,0,4" Checked="Target_Checked"
                         VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="フチ・帯の色" VerticalAlignment="Center"/>
                    <Border x:Name="OutlineChip" Style="{StaticResource Chip}"/>
                    <TextBlock x:Name="OutlineHex" VerticalAlignment="Center" FontFamily="Consolas"/>
                </StackPanel>
            </RadioButton>
        </WrapPanel>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--
              色の輪（まわりを回ると色合いが変わり、真ん中に近いほど淡くなる）。クリック・ドラッグで選ぶ。
              輪の絵と印の位置は ColorPanel.xaml.cs で描く（今の明るさで描くので、暗くすると輪も暗くなる）
            -->
            <Grid x:Name="Wheel" Width="180" Height="180" Background="Transparent" Cursor="Cross" VerticalAlignment="Top"
                  MouseLeftButtonDown="Wheel_MouseLeftButtonDown" MouseMove="Wheel_MouseMove" MouseLeftButtonUp="Wheel_MouseLeftButtonUp">
                <Image x:Name="WheelImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="Marker" Width="18" Height="18" Stroke="White" StrokeThickness="3">
                        <Ellipse.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="1" Color="Black"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <!-- 明るさ（0 で黒） -->
                <DockPanel>
                    <TextBlock Text="明るさ" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="BrightText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Grid Margin="4,0,8,0">
                        <!-- つまみの中心が動く範囲（両端から つまみの半分 = 10）に合わせる -->
                        <Border x:Name="BrightTrack" Height="8" Margin="10,0" CornerRadius="4" VerticalAlignment="Center"
                                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                        <Slider x:Name="BrightSlider" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True"
                                TickFrequency="1" IsSelectionRangeEnabled="True" ValueChanged="Bright_ValueChanged"/>
                    </Grid>
                </DockPanel>
                <!-- R / G / B（0〜255） -->
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="R" Style="{StaticResource Label}" FontWeight="Bold" Foreground="#E5484D"/>
                    <TextBox x:Name="RBox" Style="{StaticResource NumberBox}" TextChanged="ChannelBox_TextChanged" LostFocus="Box_LostFocus"/>
                    <TextBlock Text="G" Style="{StaticResource Label}" FontWeight="Bold" Foreground="#30A46C"/>
                    <TextBox x:Name="GBox" Style="{StaticResource NumberBox}" TextChanged="ChannelBox_TextChanged" LostFocus="Box_LostFocus"/>
                    <TextBlock Text="B" Style="{StaticResource Label}" FontWeight="Bold" Foreground="#3E8EED"/>
                    <TextBox x:Name="BBox" Style="{StaticResource NumberBox}" TextChanged="ChannelBox_TextChanged" LostFocus="Box_LostFocus"/>
                    <TextBlock Text="#" Style="{StaticResource Label}" FontWeight="Bold"/>
                    <TextBox x:Name="HexBox" Width="84" Padding="2" VerticalAlignment="Center" FontFamily="Consolas" MaxLength="7"
                             TextChanged="HexBox_TextChanged" LostFocus="Box_LostFocus"/>
                </WrapPanel>
                <!-- よく使う色。ColorPanel.xaml.cs で並べる -->
                <TextBlock Text="よく使う色" Margin="0,10,0,4"/>
                <WrapPanel x:Name="Swatches"/>
                <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="輪のまわりで色合い、真ん中に近いほど淡い色（真ん中は白）。明るさを 0 にすると黒。R・G・B（0〜255）や # のあとの 6 けた（例: FF5FA2）でも入れられます"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
