<UserControl x:Class="TimelapseShorts.ColorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      ④ テキストの「自由に選ぶ（RGB）」。文字の色と、フチ・帯の色を、見本の色・R/G/B のバーと数値・#RRGGBB で選ぶ。
      上の「文字の色」「フチ・帯の色」で、どちらを変えるかを切り替える。
    -->
    <UserControl.Resources>
        <!--
          R/G/B のバーは、スライダーの線を消して、後ろにその値だけを変えたときの色の変わり方を描く。
          Fluent のスライダーは「0 から今の値まで」を青く塗るので、それも出さない（IsSelectionRangeEnabled にすると、
          塗るのは SelectionStart〜SelectionEnd になり、どちらも 0 なので何も塗られない）
        -->
        <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent"/>
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent"/>
        <!-- 見本の色のボタン（色の四角。マウスを乗せると枠が太くなる） -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 選んでいる 2 色の小さな見本 -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="8,0,6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
        </Style>
        <Style x:Key="Channel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ChannelBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="12,2,0,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- つまみの中心が動く範囲（両端から つまみの半分 = 10）に合わせる -->
        <Style x:Key="Track" TargetType="Border">
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- どちらの色を変えるか -->
        <WrapPanel>
            <RadioButton x:Name="TextTarget" GroupName="ColorTarget" IsChecked="True" Margin="0,0,24,4" Checked="Target_Checked"
                         VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="文字の色" VerticalAlignment="Center"/>
                    <Border x:Name="TextChip" Style="{StaticResource Chip}"/>
                    <TextBlock x:Name="TextHex" VerticalAlignment="Center" FontFamily="Consolas"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="OutlineTarget" GroupName="ColorTarget" Margin="0,0,0,4" Checked="Target_Checked"
                         VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="フチ・帯の色" VerticalAlignment="Center"/>
                    <Border x:Name="OutlineChip" Style="{StaticResource Chip}"/>
                    <TextBlock x:Name="OutlineHex" VerticalAlignment="Center" FontFamily="Consolas"/>
                </StackPanel>
            </RadioButton>
        </WrapPanel>

        <!-- 見本の色（クリックで、選んでいる方の色にする）。ColorPanel.xaml.cs で並べる -->
        <WrapPanel x:Name="Swatches" Margin="0,8,0,0"/>

        <!-- R / G / B（バーでも数値でも） -->
        <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="R" Style="{StaticResource Channel}" Foreground="#E5484D"/>
            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Border x:Name="RTrack" Style="{StaticResource Track}"/>
                <Slider x:Name="RSlider" Maximum="255" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="True" TickFrequency="1"
                        IsSelectionRangeEnabled="True" ValueChanged="Slider_ValueChanged"/>
            </Grid>
            <TextBox Grid.Column="2" x:Name="RBox" Style="{StaticResource ChannelBox}" TextChanged="ChannelBox_TextChanged"
                     LostFocus="Box_LostFocus"/>

            <TextBlock Grid.Row="1" Text="G" Style="{StaticResource Channel}" Foreground="#30A46C"/>
            <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                <Border x:Name="GTrack" Style="{StaticResource Track}"/>
                <Slider x:Name="GSlider" Maximum="255" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="True" TickFrequency="1"
                        IsSelectionRangeEnabled="True" ValueChanged="Slider_ValueChanged"/>
            </Grid>
            <TextBox Grid.Row="1" Grid.Column="2" x:Name="GBox" Style="{StaticResource ChannelBox}" TextChanged="ChannelBox_TextChanged"
                     LostFocus="Box_LostFocus"/>

            <TextBlock Grid.Row="2" Text="B" Style="{StaticResource Channel}" Foreground="#3E8EED"/>
            <Grid Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                <Border x:Name="BTrack" Style="{StaticResource Track}"/>
                <Slider x:Name="BSlider" Maximum="255" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="True" TickFrequency="1"
                        IsSelectionRangeEnabled="True" ValueChanged="Slider_ValueChanged"/>
            </Grid>
            <TextBox Grid.Row="2" Grid.Column="2" x:Name="BBox" Style="{StaticResource ChannelBox}" TextChanged="ChannelBox_TextChanged"
                     LostFocus="Box_LostFocus"/>
        </Grid>

        <!-- #RRGGBB で直接 -->
        <WrapPanel Margin="0,6,0,0">
            <TextBlock Text="#" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox x:Name="HexBox" Width="90" Margin="6,0,12,0" Padding="2" VerticalAlignment="Center" FontFamily="Consolas"
                     MaxLength="7" TextChanged="HexBox_TextChanged" LostFocus="Box_LostFocus"/>
            <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="16 進数の 6 けた（例: FF5FA2）で直接入れることもできます"/>
        </WrapPanel>
    </StackPanel>
</UserControl>
