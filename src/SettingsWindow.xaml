<Window x:Class="TimelapseShorts.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Yu Gothic UI" FontSize="14"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,16,0,2"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Window.Resources>
    <!-- どれも選んだらすぐに変わる（覚えるのは、この画面を閉じたとき） -->
    <StackPanel Margin="20,0,20,20">
        <TextBlock Text="画面の色" Style="{StaticResource Heading}"/>
        <!-- 同じ画面にラジオボタンの組が2つあるので、GroupName で分ける -->
        <RadioButton x:Name="SystemRadio" GroupName="Theme" Content="Windows に合わせる" Checked="Theme_Checked"/>
        <RadioButton x:Name="LightRadio" GroupName="Theme" Content="ライト（明るい）" Checked="Theme_Checked"/>
        <RadioButton x:Name="DarkRadio" GroupName="Theme" Content="ダーク（暗い）" Checked="Theme_Checked"/>

        <TextBlock Text="できた動画の保存先" Style="{StaticResource Heading}"/>
        <RadioButton x:Name="SameFolderRadio" GroupName="Output" Content="元の動画と同じフォルダ" Checked="Output_Checked"/>
        <RadioButton x:Name="FixedFolderRadio" GroupName="Output" Content="決まったフォルダ" Checked="Output_Checked"/>
        <Grid Margin="28,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- 長いときは途中を「…」にして、全部はマウスを乗せると出る -->
            <TextBlock x:Name="FolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Button Grid.Column="1" x:Name="ChooseFolderButton" Content="選ぶ…" Padding="12,3" Margin="8,0,0,0"
                    Click="ChooseFolderButton_Click"/>
        </Grid>

        <TextBlock Text="作成が終わったとき" Style="{StaticResource Heading}"/>
        <CheckBox x:Name="SoundCheck" Content="音で知らせる" Checked="Done_Changed" Unchecked="Done_Changed"/>
        <CheckBox x:Name="OpenFolderCheck" Content="保存先のフォルダを開く（できた動画を選んだ状態で）"
                  Checked="Done_Changed" Unchecked="Done_Changed"/>
        <CheckBox x:Name="SleepCheck" Content="PC をスリープする" Checked="Done_Changed" Unchecked="Done_Changed"/>
        <TextBlock Margin="0,4,0,0" Style="{StaticResource Note}"
                   Text="スリープは、うまく作成できたときだけです。60 秒前にお知らせが出て、やめることもできます。作成の途中で変えても、その回から効きます。"/>

        <TextBlock Margin="0,16,0,0" Style="{StaticResource Note}"
                   Text="この画面の設定と、投稿先・総尺・冒頭に移す秒数・BGM の音量とフェード・文字のフォント／色／位置／背景／大きさは、次に起動したときも同じにします。"/>

        <Button x:Name="CloseButton" Content="閉じる" Padding="20,5" Margin="0,16,0,0" HorizontalAlignment="Right"
                IsDefault="True" IsCancel="True" Click="CloseButton_Click"/>
    </StackPanel>
</Window>
