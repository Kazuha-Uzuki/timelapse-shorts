<Project Sdk="Microsoft.NET.Sdk">

  <!-- GitHub Actions（Windows）で、同梱の ffmpeg とフォントを使って実際に変換できるかを確かめる -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/Ffmpeg.cs" />
    <Compile Include="../../src/FontCatalog.cs" />
    <!-- 画面も実際に作って、起動時に落ちないことと入力チェックを確かめる -->
    <Page Include="../../src/MainWindow.xaml" Link="MainWindow.xaml" />
    <Compile Include="../../src/MainWindow.xaml.cs" Link="MainWindow.xaml.cs" />
  </ItemGroup>

</Project>
